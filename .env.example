# 复制本文件为 .env，填入真实值后重启程序。

# MiMo 云端 API Key（必填）
MIMO_API_KEY=sk-your-mimo-api-key

# 接口地址与模型（一般无需修改）
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_TEXT_MODEL=mimo-v2.6-flash

# ffmpeg / ffprobe 可执行文件
# 已加入系统 PATH 时保持 ffmpeg / ffprobe；Windows 也可填写完整路径，如 D:/ffmpeg/bin/ffmpeg.exe
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# 需要登录/风控校验才能下载的视频：填浏览器名 chrome / edge（留空则不读取）
# 注意：浏览器正在运行时会锁住 cookie 数据库，读取前需先完全关闭该浏览器
COOKIES_FROM_BROWSER=

# 或者使用浏览器扩展导出的 cookies.txt（Netscape 格式），填文件绝对路径
# 推荐方式：无需关闭浏览器，且能避开新版浏览器的 cookie 加密限制
COOKIES_FILE=

# 请求 MiMo API 时使用的代理（如 http://127.0.0.1:7897）；留空则直连
MIMO_PROXY=

# OCR 识别置信度阈值（低于该值丢弃）
OCR_MIN_SCORE=0.5

# ASR 单块音频时长上限（秒）。过长时模型可能只转写部分，建议 180
ASR_CHUNK_SECONDS=180
